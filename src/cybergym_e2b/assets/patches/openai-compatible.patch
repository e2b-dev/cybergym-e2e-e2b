@@ -331,0 +351,24 @@ def call_llm(
+        elif model_provider == "openai-compatible":
+            import openai
+
+            client = openai.OpenAI(
+                http_client=httpx.Client(verify=os.environ.get("E2B_CA_BUNDLE", True))
+            )
+            provider_model_id = litellm_model_id.removeprefix("openai/")
+            wire_api = os.environ.get("E2B_OPENAI_WIRE_API", "chat-completions")
+            if wire_api == "responses":
+                response = client.responses.create(
+                    model=provider_model_id,
+                    input=prompt,
+                    max_output_tokens=max_tokens,
+                )
+                return response.output_text
+            if wire_api == "chat-completions":
+                response = client.chat.completions.create(
+                    model=provider_model_id,
+                    messages=[{"role": "user", "content": prompt}],
+                    max_tokens=max_tokens,
+                    temperature=0.0,
+                )
+                return response.choices[0].message.content
+            raise ValueError(f"unsupported OpenAI-compatible wire API: {wire_api}")
